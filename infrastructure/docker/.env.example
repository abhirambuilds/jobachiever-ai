# ==============================================================================
# JobAchiever AI — Local PostgreSQL Environment Variables
# Copy this file to .env before starting containers:
#   cp .env.example .env
# NOTE: .env is ignored by Git and must never contain production credentials.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=jobachiever
POSTGRES_USER=jobachiever
POSTGRES_PASSWORD=jobachiever_dev_password
POSTGRES_PORT=5432
