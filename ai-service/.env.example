# ==============================================================================
# JobAchiever AI — AI Microservice Environment Configuration
# ==============================================================================

# Service Runtime
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_LOG_LEVEL=INFO

# Internal Service Authentication
# Shared secret for trusted Spring Boot <-> FastAPI service calls
INTERNAL_SERVICE_KEY=dev-internal-service-secret-key-change-in-prod

# Maximum Upload File Size in Bytes (Default: 10 MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Allowed Origins (Internal Microservice)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ==============================================================================
# Groq AI Provider Configuration (Primary LLM Engine)
# ==============================================================================
# Provide your Groq Cloud API key (https://console.groq.com/keys)
# Keep strictly server-side; NEVER expose to client or commit to version control.
GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# Default Model Selection (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Per-Request Timeout in Seconds
GROQ_TIMEOUT_SECONDS=30.0

# Maximum Transient Error Retries (429 / 503 / timeouts)
GROQ_MAX_RETRIES=2

# Maximum Output Generation Tokens Ceiling
GROQ_MAX_OUTPUT_TOKENS=4096

# Maximum Concurrent Requests to Groq API
GROQ_MAX_CONCURRENCY=10

# ==============================================================================
# Google Gemini AI Provider Configuration (Secondary LLM Engine)
# ==============================================================================
# Provide your Google Gemini API key (https://aistudio.google.com/)
# Keep strictly server-side; NEVER expose to client or commit to version control.
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_placeholder

# Default Model Selection (e.g., gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash)
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Per-Request Timeout in Seconds
GEMINI_TIMEOUT_SECONDS=30.0

# Maximum Output Generation Tokens Ceiling
GEMINI_MAX_OUTPUT_TOKENS=4096

# Maximum Concurrent Requests to Gemini API
GEMINI_MAX_CONCURRENCY=10
