# ==============================================================================
# JobAchiever AI — AI Microservice Environment Configuration
# ==============================================================================

# Service Runtime
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_LOG_LEVEL=INFO

# Internal Service Authentication
# Shared secret for trusted Spring Boot <-> FastAPI service calls
INTERNAL_SERVICE_KEY=dev-internal-service-secret-key-change-in-prod

# Maximum Upload File Size in Bytes (Default: 10 MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Allowed Origins (Internal Microservice)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
